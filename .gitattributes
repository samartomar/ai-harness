# Normalize to LF in the repo so Biome formatting and golden-file tests stay
# stable regardless of the contributor's OS / git autocrlf setting.
* text=auto eol=lf
*.png binary
*.ico binary
src/baseline-evidence/pin-currency.ts text eol=lf diff
# Deliberately truncated JSON: each file ends inside a value, after a blank, and the
# trust-parity goldens were captured from these exact bytes.
tests/fixtures/trust-parity/corpus/malformed/* whitespace=-blank-at-eol
