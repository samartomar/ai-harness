node_modules/
dist/
coverage/
*.tsbuildinfo
__pycache__/
*.py[cod]

# aih runtime artifacts
.aih-scratch/
.aih-workflow/
.token-savior-cache.json

# generated, machine-local AI client projections and helper indexes
/.codex/config.toml
/.codex/hooks.json
/.serena/
/.code-review-graph/
/.codebase-memory/

# logs / os
*.log
.DS_Store
Thumbs.db

# local env (the harness scans for these; never commit them)
.env
.env.*
!.env.example

# internal (non-public) docs — clone samartomar/ai-harness-internal here for
# cross-agent access without exposing competitive/roadmap/handoff docs publicly
.internal/

# Claude Code session artifacts (agent worktrees and machine-local state).
# Project-curated, cross-CLI skills live under ai-coding/curated-skills/ and
# route via the canon; client-specific projections stay local.
.claude/*

# aih pack-install promotion output: skills are promoted here from their
# committed source under packs/**. The promoted copy is regenerated by
# `aih pack install` and must not be double-committed (single-source-of-truth).
ai-coding/skills/

# aih artifacts — never tracked (this checkout is not aih-governed); root-anchored
# so committed test fixtures under tests/fixtures/**/.aih stay addable
*.aih.bak
*.aih.tmp
.aih-truth.json
/.aih/

# local vet provisioning (pinned vendor checkouts; CI recreates its own)
.baseline-sources/
