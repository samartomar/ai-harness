{
  "name": "@aihq/core",
  "version": "0.5.0",
  "description": "AI Development Assurance governance core for exact tools, skills, MCP servers, packages, evidence, approval, observation, and audit history",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samartomar/ai-harness.git"
  },
  "homepage": "https://github.com/samartomar/ai-harness#readme",
  "bugs": {
    "url": "https://github.com/samartomar/ai-harness/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "aih": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "src/baseline-evidence/vendor-lock.json",
    "src/baseline-evidence/ecc-install-preview.json",
    "src/ecc-profile/serena-runtime",
    "tools/cisco-skill-scanner",
    "tools/trust-scanners",
    "packs",
    "!packs/**/__pycache__",
    "!packs/**/*.py[cod]",
    "guides",
    "docs/assets",
    "docs/commands.md",
    "!docs/README.md",
    "README.md",
    "CHANGELOG.md",
    "RELEASING.md",
    "VERSIONING.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:workbench && tsup && node tools/build-workbench.mjs --copy-to-dist && tsc -p tsconfig.dts.json",
    "dev": "tsx src/cli.ts",
    "repo:init": "node tools/repo-ai-tools.mjs setup-codex",
    "repo:doctor": "node tools/repo-ai-tools.mjs doctor-codex",
    "test": "npm run build:workbench && vitest run",
    "test:watch": "npm run build:workbench && vitest",
    "test:cov": "npm run build:workbench && vitest run --coverage",
    "test:core": "vitest run --config vitest.core.config.ts",
    "test:core:cov": "vitest run --config vitest.core.config.ts --coverage",
    "test:workbench": "npm run build:workbench && vitest run --config vitest.workbench.config.ts",
    "test:workbench:cov": "npm run build:workbench && vitest run --config vitest.workbench.config.ts --coverage",
    "check:scan-acceptance": "tsx src/binding/scan-acceptance-check.ts",
    "regen:scan-acceptance": "tsx src/binding/scan-acceptance-regenerate.ts",
    "check:artifacts": "tsx src/internals/check-tracked-artifacts.ts",
    "check:staged": "tsx src/internals/staged-check.ts",
    "ci:classify": "tsx src/internals/ci-impact-command.ts",
    "ci:run-selected": "node --import tsx .github/scripts/run-selected-tests.mjs",
    "check:ai-runtime": "tsx src/internals/ai-runtime-inventory.ts --root .",
    "check:bugbounty-report": "tsx src/internals/bugbounty-report.ts --source .internal/defects/BUGBOUNTY.md",
    "check:self-hosting-canon": "vitest run tests/self-hosting/self-hosting.test.ts",
    "check:ecc-installer": "tsx src/internals/check-ecc-installer.ts",
    "check:baseline-analyzers": "tsx src/internals/check-baseline-analyzers.ts",
    "check:native-identity": "tsx src/internals/check-native-identity.ts",
    "check:baseline-pins": "tsx src/internals/check-baseline-pin-currency.ts",
    "baseline:native-identity": "tsx src/internals/check-native-identity.ts --write",
    "check:baseline-installable": "tsx src/internals/check-baseline-installable.ts",
    "check:packed-doc-links": "tsx src/internals/check-packed-doc-links.ts",
    "check:lock-migration": "tsx src/internals/assert-identity-only-lock-migration.ts",
    "baseline:request": "tsx src/baseline-evidence/scanner-cli.ts request",
    "baseline:consume-publication": "tsx src/baseline-evidence/scanner-cli.ts consume-publication",
    "baseline:consume-publications": "tsx src/baseline-evidence/scanner-cli.ts consume-publications",
    "baseline:assemble": "tsx src/baseline-evidence/scanner-cli.ts assemble",
    "baseline:check": "npm run check:baseline-pins && npm run check:baseline-analyzers && npm run check:baseline-installable",
    "baseline:artifact": "tsx src/baseline-evidence/vendor-artifact.ts",
    "release:preflight": "tsx src/internals/release-preflight.ts",
    "release:governance": "tsx src/internals/delivery-governance-command.ts",
    "check:published-bin": "node dist/cli.js --version && node dist/cli.js --help",
    "check:published-library": "node -e \"import('@aihq/core').then((m)=>{ if (typeof m.runSessionGuardrails !== 'function') throw new Error('missing library export'); })\"",
    "verify:cold-aih-managed-usage": "npm run build && node tools/verify-cold-aih-managed-usage.mjs",
    "verify:cold-upstream-artifact-lifecycle": "npm run build && node tools/verify-cold-upstream-artifact-lifecycle.mjs",
    "verify:packed-admin-docs": "tsx tools/verify-packed-administrator-docs.mjs",
    "verify:release-candidate": "npm run check:baseline-analyzers && npm run check:native-identity && npm run check:baseline-pins && npm run check:baseline-installable && npm run check:ai-runtime && npm run check:bugbounty-report && npm run docs:lint && npm run check:packed-doc-links && npm run build && npm run check:published-bin && npm run check:published-library && npm run verify:packed-admin-docs && node tools/verify-cold-upstream-artifact-lifecycle.mjs",
    "docs:lint": "tsx src/internals/check-repo-docs.ts",
    "lint": "biome check src tests",
    "lint:fix": "biome check --write src tests",
    "lint:ci": "biome ci src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit && npm run typecheck:workbench",
    "verify": "npm run check:artifacts && npm run check:self-hosting-canon && npm run check:ecc-installer && npm run check:baseline-analyzers && npm run check:native-identity && npm run check:baseline-pins && npm run check:baseline-installable && npm run check:ai-runtime && npm run check:bugbounty-report && npm run docs:lint && npm run check:packed-doc-links && npm run typecheck && npm run lint:ci && npm run test:cov && npm run build && npm run check:published-bin && npm run check:published-library && npm run verify:packed-admin-docs && node tools/verify-cold-upstream-artifact-lifecycle.mjs",
    "build:workbench": "node tools/build-workbench.mjs",
    "test:workbench:pure": "vitest run --config vitest.workbench-pure.config.ts --coverage",
    "test:workbench:ui": "npm run build && playwright test --config playwright.workbench.config.ts",
    "typecheck:workbench": "tsc -p tsconfig.workbench.json && tsc -p tsconfig.workbench-browser-tests.json",
    "test:workbench:contracts": "vitest run --config vitest.workbench-contracts.config.ts",
    "test:workbench:pr": "node tools/run-workbench-pr-lane.mjs"
  },
  "keywords": [
    "ai",
    "harness",
    "bootstrap",
    "devsecops",
    "enterprise",
    "claude-code",
    "mcp"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "jsonc-parser": "^3.3.1",
    "yaml": "2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aihq/scan": "0.3.0",
    "@biomejs/biome": "^2.5.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "acorn": "^8.17.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "esbuild": "0.28.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
