{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": [
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "hosts/**/*.ts",
    "hosts/**/*.tsx",
    // The hosts import the stylesheet; its ambient declaration lives in src/.
    "src/env.d.ts",
    "vite.config.ts",
    "preview/fixture-plugin.ts"
  ],
  "exclude": []
}
